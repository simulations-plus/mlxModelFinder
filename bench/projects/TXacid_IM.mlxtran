<DATAFILE>

[FILEINFO]
file={path='TXAacid_IMroute.csv'}
delimiter = comma
header={ID, AGE, SEX, WEIGHT, ROUTE, AMOUNT, TIME, DV, HEMATOCRIT}

[CONTENT]
ID = {use=identifier}
AGE = {use=covariate, type=continuous}
SEX = {use=covariate, type=categorical}
WEIGHT = {use=covariate, type=continuous}
ROUTE = {use=covariate, type=categorical}
AMOUNT = {use=amount}
TIME = {use=time}
DV = {use=observation, type=continuous}
HEMATOCRIT = {use=covariate, type=continuous}

<MODEL>

[COVARIATE]
input = {AGE, HEMATOCRIT, WEIGHT, SEX}

SEX = {type=categorical, categories={'1', '2'}}

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V_pop, omega_V}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}

[LONGITUDINAL]
input = {a, b}

file = 'lib:bolus_1cpt_VCl.txt'

DEFINITION:
DV = {distribution=normal, prediction=Cc, errorModel=combined1(a, b)}

<FIT>
data = 'DV'
model = DV

<PARAMETER>
Cl_pop = {value=0.5, method=MLE}
V_pop = {value=1, method=MLE}
a = {value=1, method=MLE}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
omega_Cl = {value=1, method=MLE}
omega_V = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(run = false,method = StochasticApproximation)
logLikelihood(run = false,method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'TXacid_IM'
dataandmodelnexttoproject = yes

