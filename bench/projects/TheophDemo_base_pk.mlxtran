<DATAFILE>

[FILEINFO]
file={path='Theoph_demo.csv'}
delimiter = comma
header={ID, AMT, TIME, CONC, WEIGHT, SEX}

[CONTENT]
ID = {use=identifier}
AMT = {use=amount}
TIME = {use=time}
CONC = {use=observation, type=continuous}
WEIGHT = {use=covariate, type=continuous}
SEX = {use=covariate, type=categorical}

<MODEL>

[COVARIATE]
input = {WEIGHT, SEX}

SEX = {type=categorical, categories={'F', 'M'}}

[INDIVIDUAL]
input = {Cl_pop, omega_Cl, V_pop, omega_V, Tlag_pop, omega_Tlag, Tk0_pop, omega_Tk0}

DEFINITION:
Cl = {distribution=logNormal, typical=Cl_pop, sd=omega_Cl}
V = {distribution=logNormal, typical=V_pop, sd=omega_V}
Tlag = {distribution=logNormal, typical=Tlag_pop, sd=omega_Tlag}
Tk0 = {distribution=logNormal, typical=Tk0_pop, sd=omega_Tk0}

[LONGITUDINAL]
input = {a, b}

file = 'lib:oral0_1cpt_TlagTk0VCl.txt'

DEFINITION:
CONC = {distribution=normal, prediction=Cc, errorModel=combined1(a, b)}

<FIT>
data = 'CONC'
model = CONC

<PARAMETER>
Cl_pop = {value=0.0399, method=MLE}
Tk0_pop = {value=1.1, method=MLE}
Tlag_pop = {value=0.0000728, method=MLE}
V_pop = {value=0.481, method=MLE}
a = {value=1, method=MLE}
b = {value=0.3, method=MLE}
c = {value=1, method=FIXED}
omega_Cl = {value=1, method=MLE}
omega_Tk0 = {value=1, method=MLE}
omega_Tlag = {value=1, method=MLE}
omega_V = {value=1, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'TheophDemo_base_pk'
dataandmodelnexttoproject = yes

POPULATION:
variability = firstStage

